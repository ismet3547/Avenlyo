  },
  "dependencies": {
    "@avenlyo/ai": "workspace:*",
    "@avenlyo/database": "workspace:*",
    "@avenlyo/industries": "workspace:*",
    "@avenlyo/integrations": "workspace:*",
    "@avenlyo/knowledge": "workspace:*",
    "@avenlyo/messaging": "workspace:^",
    "@avenlyo/shared": "workspace:*",
    "@avenlyo/voice": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "openai": "^6.49.0",
    "playwright-core": "^1.62.1",
    "stripe": "^18.5.0",
    "tsx": "^4.19.3",
    "twilio": "^5.11.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
