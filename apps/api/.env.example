# Deployment identifier surfaced through health, logs, and ops:status. A commit SHA is ideal.
# Optional: a missing value reports "unknown" and never blocks local development.
AVENLYO_RELEASE=

API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000
# Exact HTTPS Avenlyo web origin allowed to call the public chat iframe endpoints.
# Use a local development origin only outside production.
WEB_CHAT_IFRAME_ORIGIN=http://localhost:3000

# Required only to call protected API routes such as GET /v1/me.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required only for the trusted inbound Realtime SIP webhook and sideband runtime.
# Never expose these values through NEXT_PUBLIC_ variables or the browser.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=whsec_...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_PROJECT_ID=proj_...
OPENAI_AGENT_MODEL=gpt-5.6

# Required only for the trusted ezyVet scheduling execution boundary. This partner credential
# belongs to Avenlyo, not an individual clinic. Clinic client credentials are stored in Vault.
EZYVET_PARTNER_ID=

# Avenlyo-owned Google OAuth application credentials. Per-business refresh tokens are stored
# only through Supabase Vault; none of these values are browser-exposed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/v1/scheduling/google-calendar/callback

# Avenlyo-owned Twilio Messaging credentials. Configure the exact public webhook base URL;
# Fastify derives both callback URLs from it and never trusts forwarded-host headers.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_WEBHOOK_BASE_URL=https://api.example.com

# Stripe Billing (Phase 12). These values are server-only and must never be exposed as NEXT_PUBLIC_ variables.
# Set STRIPE_MODE=test for local/test credentials and live only with an sk_live_ key in production.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_CORE=
STRIPE_PRICE_CORE_MONTHLY=
