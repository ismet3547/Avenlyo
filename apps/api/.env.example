API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# Required only to call protected API routes such as GET /v1/me.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required only for the trusted inbound Realtime SIP webhook and sideband runtime.
# Never expose these values through NEXT_PUBLIC_ variables or the browser.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=whsec_...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_PROJECT_ID=proj_...
