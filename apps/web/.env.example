# Deployment identifier reported by GET /api/health. Optional; defaults to "unknown".
AVENLYO_RELEASE=

# Leave Supabase values blank to run public and auth pages without a local backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only address used by the integration management actions.
AVENLYO_API_URL=http://localhost:4000
# Shared only between this server and the Fastify API. It authenticates which workspace a billing
# mutation is acting on. At least 32 characters, never NEXT_PUBLIC_, never given to a browser.
# Billing checkout, portal, and refresh fail closed while it is missing on either side.
AVENLYO_INTERNAL_BILLING_SECRET=
NEXT_PUBLIC_AVENLYO_API_URL=http://localhost:4000
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_AGENT_MODEL=gpt-5.6
