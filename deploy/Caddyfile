# Avenlyo Hetzner staging reverse proxy.
#
# Caddy is the only internet-facing process (ports 80/443). Both upstreams are reached by Docker's
# internal DNS -- `web` and `api` are the compose service names in deploy/compose.yaml, not
# 127.0.0.1, which from inside this container would loop back to Caddy itself.
#
# TLS is fully automatic: Caddy requests and renews certificates via ACME (Let's Encrypt) the
# moment DNS for these two hostnames resolves to this host and 80/443 are reachable. No certificate
# file is ever committed to this repository, and no Certbot or other separate ACME client is used.

staging.avenlyo.com {
	reverse_proxy web:3000
}

api-staging.avenlyo.com {
	reverse_proxy api:4000 {
		# Replace the forwarding chain, never append to it.
		#
		# Caddy's default is to append the connecting address to whatever X-Forwarded-For arrived,
		# which means an internet client can prepend entries of its choosing and they survive the
		# hop. The API decides a caller's abuse-control identity from this header, so an attacker
		# writing its own value there is an attacker choosing its own rate-limit bucket -- or
		# someone else's. `{remote_host}` is the address Caddy actually accepted the connection
		# from, so anything the client wrote is discarded here, at the only hop that knows the
		# truth.
		#
		# The API does not depend on this being correct: apps/api/src/security/client-identity.ts
		# trusts a forwarding header only from an internal peer, so a spoofed chain would be
		# ignored there too. Two independent controls, either sufficient.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
