# syntax=docker/dockerfile:1
#
# Production image for @avenlyo/web.
#
# The production runtime here is already correct as-is -- `next build` followed by `next start` --
# and this file does not change that. `output: standalone` was considered and deliberately not used:
# this monorepo's workspace packages (@avenlyo/ai, @avenlyo/knowledge, @avenlyo/shared, @avenlyo/ui,
# ...) export raw TypeScript with no dist, and Next's file-tracing for standalone mode is one more
# untested surface in a PR that cannot run Docker locally. A normal container -- the built .next
# output plus a full node_modules -- is larger but has no tracing edge cases to get wrong. This can
# be revisited once a real Hetzner host can prove standalone tracing includes everything it needs.
#
# NEXT_PUBLIC_* variables are compiled into the client JavaScript bundle at `next build` time, not
# read at container start -- see docs/deployment/hetzner-staging.md for why they are build ARGs here
# rather than runtime environment variables. None of their values are set in this file; every ARG
# below defaults to empty and must be supplied at build time by whatever builds this image.

FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

FROM base AS build

COPY . .
RUN pnpm install --frozen-lockfile

# Build-time-only, browser-facing configuration. These are public values (an anon key, a base URL),
# but still never hardcoded into the repository -- they are supplied by whatever builds this image,
# the same way any other deployment-specific configuration is.
ARG NEXT_PUBLIC_SUPABASE_URL=""
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY=""
ARG NEXT_PUBLIC_APP_URL=""
ARG NEXT_PUBLIC_AVENLYO_API_URL=""
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_AVENLYO_API_URL=${NEXT_PUBLIC_AVENLYO_API_URL}

RUN pnpm --filter @avenlyo/web build

# ---------------------------------------------------------------------------------------------
# runtime: fresh base image, the built .next output, and everything `next start` needs from
# node_modules to run -- preserving pnpm's relative workspace symlink structure exactly as the API
# image does, for the same reason.
# ---------------------------------------------------------------------------------------------
FROM base AS runtime

RUN groupadd --system --gid 10002 avenlyo \
    && useradd --system --uid 10002 --gid avenlyo --home-dir /home/avenlyo --create-home avenlyo

COPY --from=build /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/web/package.json ./apps/web/package.json
COPY --from=build /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=build /app/apps/web/next.config.ts ./apps/web/next.config.ts
COPY --from=build /app/apps/web/.next ./apps/web/.next
COPY --from=build /app/apps/web/public ./apps/web/public

WORKDIR /app/apps/web

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN chown -R avenlyo:avenlyo /app /home/avenlyo

USER avenlyo

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r => process.exit(r.status === 200 ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node_modules/.bin/next", "start"]
