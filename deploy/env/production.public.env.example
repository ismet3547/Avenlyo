# Avenlyo production -- PUBLIC deployment settings only.
#
# PRODUCTION HAS NOT BEEN DEPLOYED. This file is the deployment contract, not evidence that a
# production environment exists. No DNS record has been created, no Supabase project provisioned,
# no provider configured. See docs/deployment/production.md.
#
# ---------------------------------------------------------------------------------------------
# How this file is used
# ---------------------------------------------------------------------------------------------
# It IS the deployment profile -- the file passed to `docker compose --env-file`. It carries exactly
# the same set of keys as deploy/env/staging.public.env.example; only the values differ. Assemble
# the real one from this template plus the two browser-facing Supabase values, which are
# deployment-specific and therefore not committed:
#
#   cat deploy/env/production.public.env.example deploy/env/build.env.example > deploy/env/build.env
#   # then fill in NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY and AVENLYO_RELEASE
#
# Every command in the deploy -- build, profile assertion, preflight, `up -d` -- reads that one
# file. See docs/production-runbook.md, "Deployment order".
#
# Every secret keeps its single home in the server-only templates:
#
#   deploy/env/web.env.example     server-only web runtime configuration
#   deploy/env/api.env.example     server-only API runtime configuration
#
# NOTHING HERE IS A SECRET. Nothing here may ever become one: these values are chosen so the file
# can be committed, rendered in CI, and printed in a terminal.

# ---------------------------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------------------------
# The one value that tells staging and production apart. NODE_ENV cannot: staging runs
# NODE_ENV=production too, deliberately, so it exercises production runtime behaviour. Every
# environment-sensitive check keys off this instead, and a production-mode container that does not
# declare it refuses to start rather than guessing.
#
# It appears twice on a host, on purpose: here, as the profile's declaration, and in
# /etc/avenlyo/api.env, as the API process's own runtime identity. deploy/compose.yaml passes this
# copy in as AVENLYO_PROFILE_DEPLOYMENT_ENV so preflight can prove the two agree -- a container
# declaring one deployment while rendered from the other's profile is a cross-wire neither file can
# detect alone.
AVENLYO_DEPLOYMENT_ENV=production

# The exact commit being deployed: a full 40-character lowercase SHA, nothing else. Not `latest`,
# not a branch, not an abbreviation. The build-once/deploy-that-image model depends on a tag meaning
# one set of bytes forever, and `ops:preflight` refuses a deployed release that is anything else.
AVENLYO_RELEASE=

# ---------------------------------------------------------------------------------------------
# Public hostnames -- deploy/Caddyfile substitutes these
# ---------------------------------------------------------------------------------------------
# Caddy's upstreams (web:3000, api:4000, internal :8080) are literals in the Caddyfile and are NOT
# configurable. These choose the public names only.
#
# avenlyo.com is the settled production web domain. The API hostname below is deployment
# configuration and an example -- it is NOT a claim that this DNS record exists or that the name has
# been decided. Set it to whatever is actually provisioned before deploying.
AVENLYO_WEB_HOST=avenlyo.com
AVENLYO_API_HOST=api.avenlyo.com

# ---------------------------------------------------------------------------------------------
# Build-time, browser-facing (goes in the file passed to `docker compose --env-file`)
# ---------------------------------------------------------------------------------------------
# Compiled into the client bundle at build time; setting them at runtime has no effect. They must
# agree with the hostnames above, and `ops:preflight` fails the deployment if they do not.
NEXT_PUBLIC_APP_URL=https://avenlyo.com
NEXT_PUBLIC_AVENLYO_API_URL=https://api.avenlyo.com

# ---------------------------------------------------------------------------------------------
# Server-only, environment-sensitive (merge into /etc/avenlyo/api.env and web.env)
# ---------------------------------------------------------------------------------------------
# Both must name the same origin as NEXT_PUBLIC_APP_URL. They are the two controls standing between
# a customer's website and this API, so a drift here is a security defect, not a typo.
API_CORS_ORIGIN=https://avenlyo.com
WEB_CHAT_IFRAME_ORIGIN=https://avenlyo.com

# The web container's server-side path to the API, and the ONLY authority for it. Phase 19 put web
# and api on separate networks, so `http://api:4000` cannot resolve and must not come back: this
# value crossing Caddy is what keeps the API's trusted-proxy boundary a single hop.
#
# deploy/compose.yaml wires the web service's runtime AVENLYO_API_URL from this key, so the value
# preflight validates and the value the container runs with are the same value. It is identical in
# staging and production, and deploy/env/web.env.example no longer carries a second copy.
AVENLYO_API_URL=http://caddy:8080

# REQUIRED in production, and non-secret. A Supabase project URL is an opaque ref that says nothing
# about which environment it belongs to, so pointing production at the staging database is NOT
# detectable from the URL alone. Declaring the ref you intend here makes a mismatch provable.
#
# Leaving it unset is not a neutral omission -- it is the unverified state, and `ops:preflight`
# FAILS a production run without it rather than passing a check it did not perform. (On staging an
# undeclared expectation is reported as unverified and does not fail.)
#
# The comparison is made against the canonical hosted project origin, https://<ref>.supabase.co. An
# arbitrary domain whose first DNS label happens to equal this value is a MISMATCH, not a match.
AVENLYO_EXPECTED_SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------------------------
# Environment-sensitive provider callbacks -- set ONLY in the server-only files, with the secrets
# ---------------------------------------------------------------------------------------------
# Listed here as a reminder that they are environment-sensitive and are checked, not as a place to
# put them. Each lives beside its credential in api.env.
#
#   GOOGLE_OAUTH_REDIRECT_URI          when set: the public API origin plus the callback route the
#                                      API actually serves,
#                                      /v1/scheduling/google-calendar/callback -- no query, no
#                                      fragment, no other host, no unpublished port
#   TWILIO_MESSAGING_WEBHOOK_BASE_URL  when set: the public API origin with NO path prefix; the
#                                      webhook routes are absolute, so a prefix builds a URL this
#                                      API does not serve
#   STRIPE_MODE                        must be `live` in a production deployment -- `test` is
#                                      rejected at startup, keyed on AVENLYO_DEPLOYMENT_ENV rather
#                                      than NODE_ENV, so staging may still use test mode
#
# NEVER put a secret in this file or in a Docker build arg. Next inlines build args into the browser
# bundle, which would publish the value to every visitor. That means never here, and never
# NEXT_PUBLIC_-prefixed:
#   OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#   TWILIO_AUTH_TOKEN, GOOGLE_CLIENT_SECRET, AVENLYO_INTERNAL_BILLING_SECRET, OPENAI_WEBHOOK_SECRET
