# Template only -- placeholders, no real values. The actual file lives at /etc/avenlyo/api.env on
# the Hetzner host, mode 0640, owned by a dedicated user/group, and is never committed.
#
# NODE_ENV=production is deliberate for staging, per docs/deployment/hetzner-staging.md: staging
# must exercise production runtime behavior. AVENLYO_DEPLOYMENT_ENV below is what says which
# deployment this actually is, and the Stripe rule keys off that rather than off NODE_ENV -- so
# STRIPE_MODE=test is permitted on staging, and rejected only in a production deployment.
#
# Stripe is nevertheless left entirely unconfigured at this project stage (see below). Leaving every
# Stripe variable unset boots with billing capability disabled, fail-closed, exactly as the
# application already decides when its Stripe boundary is unconfigured.

AVENLYO_RELEASE=
NODE_ENV=production
# Required alongside NODE_ENV=production -- the process refuses to start without it. Kept here
# rather than only in the Phase 20 section below, because a file copied from the top of this
# template without it does not boot. See that section for what it means.
#
# It must equal the AVENLYO_DEPLOYMENT_ENV in the deployment profile (deploy/env/build.env). This
# file and that one are edited separately, so they can disagree; Compose mirrors the profile's copy
# in as AVENLYO_PROFILE_DEPLOYMENT_ENV and preflight fails the deployment when the two differ. The
# profile deliberately cannot overwrite this value -- Compose's `environment:` beats `env_file:`, so
# letting it supply this name would let a profile silently replace the container's own identity.
AVENLYO_DEPLOYMENT_ENV=staging
API_HOST=0.0.0.0
API_PORT=4000

# The staging web origin. Must be HTTPS -- apps/api/src/env.ts enforces this under
# NODE_ENV=production for both of these.
API_CORS_ORIGIN=https://staging.avenlyo.com
WEB_CHAT_IFRAME_ORIGIN=https://staging.avenlyo.com

# Required for the readiness probe and every trusted RPC. Hosted Supabase staging project -- never
# the production project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# API-only. Never place this value in web.env.
SUPABASE_SERVICE_ROLE_KEY=

# Shared with the web app's copy of the same name (web.env.example) -- must be byte-identical.
AVENLYO_INTERNAL_BILLING_SECRET=

# --- Optional / integration-dependent -------------------------------------------------------
# Every capability below is independently optional at boot (apps/api/src/env.ts): the process
# starts and serves traffic with any subset of these unset, and the corresponding feature reports
# itself unconfigured rather than failing. Uncomment and fill in only what this stage of staging
# actually needs to exercise.

# OPENAI_API_KEY=
# OPENAI_AGENT_MODEL=gpt-5.6
# OPENAI_PROJECT_ID=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_WEBHOOK_SECRET=

# Payments are intentionally not configured at this project stage. Do not set STRIPE_MODE or any
# STRIPE_* value merely to make staging boot -- it already boots correctly with all of them unset.
# STRIPE_MODE=live
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRODUCT_CORE=
# STRIPE_PRICE_CORE_MONTHLY=

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_WEBHOOK_BASE_URL=https://api-staging.avenlyo.com

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://api-staging.avenlyo.com/v1/scheduling/google-calendar/callback
#
# Both callback settings above are checked for ALIGNMENT, not just HTTPS: each must name this
# deployment's own public API origin, on a port Caddy publishes, with no query or fragment. The
# Google URI must use the exact route the API serves
# (/v1/scheduling/google-calendar/callback), and the Twilio base URL must carry NO path prefix --
# the webhook routes are absolute, so a prefix builds a URL nothing routes. An unrelated HTTPS host
# is a login that dead-ends after the user has consented, and inbound messages that never arrive.

# EZYVET_PARTNER_ID=

# --- Chromium / knowledge-import worker ------------------------------------------------------
# Baked into the deploy/Dockerfile.api image itself (ENV KNOWLEDGE_RENDERER_EXECUTABLE_PATH), not
# set here. Listed for awareness only -- do not override it in this file unless deliberately
# pointing at a different browser than the one the image ships.
# KNOWLEDGE_RENDERER_EXECUTABLE_PATH=/opt/avenlyo/chromium/chrome

# ---------------------------------------------------------------------------------------------
# Deployment identity (Phase 20)
# ---------------------------------------------------------------------------------------------
# Which deployment this is. Required whenever NODE_ENV=production, because staging and production
# both run in production mode and nothing else can tell them apart -- a container that omits it
# refuses to start rather than guessing which set of environment rules applies to it.
#   development | staging | production
# Set at the top of this file, beside NODE_ENV, because the two must be read together.

# Optional on staging, MANDATORY in production, and non-secret. A Supabase project URL cannot prove
# which environment it belongs to. Declare the project ref you intend and `ops:preflight` can prove a
# mismatch; leave it unset on staging and preflight honestly reports the check as unverified.
#
# The comparison is made against the canonical hosted project origin, https://<ref>.supabase.co --
# scheme, host suffix, no port, no path, no query. An arbitrary domain whose first DNS label happens
# to equal this value is a MISMATCH, not a match: proving the intended project is the whole point,
# and a check any subdomain name could satisfy would prove nothing while looking green.
AVENLYO_EXPECTED_SUPABASE_PROJECT_REF=
