# Template only -- placeholders, no real values. The actual file lives at /etc/avenlyo/api.env on
# the Hetzner host, mode 0640, owned by a dedicated user/group, and is never committed.
#
# NODE_ENV=production is deliberate for staging, per docs/deployment/hetzner-staging.md: staging
# must exercise production runtime behavior. Do not set STRIPE_MODE=test to work around this --
# Stripe is intentionally left entirely unconfigured at this project stage (see below), and the
# existing production guard in apps/api/src/env.ts only rejects NODE_ENV=production combined with
# STRIPE_MODE=test specifically. Leaving every Stripe variable unset avoids that guard entirely and
# boots with billing capability disabled, fail-closed, exactly as the application already decides
# when its Stripe boundary is unconfigured.

AVENLYO_RELEASE=
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000

# The staging web origin. Must be HTTPS -- apps/api/src/env.ts enforces this under
# NODE_ENV=production for both of these.
API_CORS_ORIGIN=https://staging.avenlyo.com
WEB_CHAT_IFRAME_ORIGIN=https://staging.avenlyo.com

# Required for the readiness probe and every trusted RPC. Hosted Supabase staging project -- never
# the production project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# API-only. Never place this value in web.env.
SUPABASE_SERVICE_ROLE_KEY=

# Shared with the web app's copy of the same name (web.env.example) -- must be byte-identical.
AVENLYO_INTERNAL_BILLING_SECRET=

# --- Optional / integration-dependent -------------------------------------------------------
# Every capability below is independently optional at boot (apps/api/src/env.ts): the process
# starts and serves traffic with any subset of these unset, and the corresponding feature reports
# itself unconfigured rather than failing. Uncomment and fill in only what this stage of staging
# actually needs to exercise.

# OPENAI_API_KEY=
# OPENAI_AGENT_MODEL=gpt-5.6
# OPENAI_PROJECT_ID=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_WEBHOOK_SECRET=

# Payments are intentionally not configured at this project stage. Do not set STRIPE_MODE or any
# STRIPE_* value merely to make staging boot -- it already boots correctly with all of them unset.
# STRIPE_MODE=live
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRODUCT_CORE=
# STRIPE_PRICE_CORE_MONTHLY=

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_WEBHOOK_BASE_URL=https://api-staging.avenlyo.com

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://api-staging.avenlyo.com/v1/scheduling/google-calendar/callback

# EZYVET_PARTNER_ID=

# --- Chromium / knowledge-import worker ------------------------------------------------------
# Baked into the deploy/Dockerfile.api image itself (ENV KNOWLEDGE_RENDERER_EXECUTABLE_PATH), not
# set here. Listed for awareness only -- do not override it in this file unless deliberately
# pointing at a different browser than the one the image ships.
# KNOWLEDGE_RENDERER_EXECUTABLE_PATH=/opt/avenlyo/chromium/chrome

# ---------------------------------------------------------------------------------------------
# Deployment identity (Phase 20)
# ---------------------------------------------------------------------------------------------
# Which deployment this is. Required whenever NODE_ENV=production, because staging and production
# both run in production mode and nothing else can tell them apart -- a container that omits it
# refuses to start rather than guessing which set of environment rules applies to it.
#   development | staging | production
AVENLYO_DEPLOYMENT_ENV=staging

# Optional, non-secret. A Supabase project URL cannot prove which environment it belongs to. Declare
# the project ref you intend and `ops:preflight` can prove a mismatch; leave it unset and preflight
# honestly reports the check as unverified.
AVENLYO_EXPECTED_SUPABASE_PROJECT_REF=
