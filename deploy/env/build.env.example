# Template only -- placeholders, no real values.
#
# Build-time-only configuration for deploy/Dockerfile.web, consumed by `docker compose build` (or
# `docker build --build-arg`) via deploy/compose.yaml's `build.args`. These are Next.js
# NEXT_PUBLIC_* variables: the framework inlines them into the client JavaScript bundle at
# `next build` time. Setting them as a normal runtime environment variable (the way web.env.example
# and api.env.example work) would have no effect -- the value has to exist before the image is
# built, not when the container starts.
#
# They are public values by the nature of NEXT_PUBLIC_* (an anon key scoped by RLS, a base URL) --
# this file is still never committed with real values, for the same reason web.env.example and
# api.env.example are templates: no deployment-specific configuration belongs in the repository.
#
# Usage: `docker compose --env-file deploy/env/build.env -f deploy/compose.yaml build web`

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://staging.avenlyo.com
NEXT_PUBLIC_AVENLYO_API_URL=https://api-staging.avenlyo.com
