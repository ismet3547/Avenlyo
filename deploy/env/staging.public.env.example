# Avenlyo staging -- PUBLIC deployment profile.
#
# The staging half of the same contract as deploy/env/production.public.env.example. Both files
# carry exactly the same set of keys; only the values differ. That symmetry is the point: a value
# that exists in one environment and not the other is a difference nobody chose, and it is always
# discovered later, in the environment where discovering it is expensive.
#
# NOTHING HERE IS A SECRET. Nothing here may ever become one: these values are chosen so the file
# can be committed, rendered in CI, and printed in a terminal. The secrets keep their single homes
# in deploy/env/api.env.example and deploy/env/web.env.example.
#
# ---------------------------------------------------------------------------------------------
# How this file is used
# ---------------------------------------------------------------------------------------------
# It IS the deployment profile -- the file passed to `docker compose --env-file`. Assemble the real
# one from this template plus the two browser-facing Supabase values, which are deployment-specific
# and therefore not committed:
#
#   cat deploy/env/staging.public.env.example deploy/env/build.env.example > deploy/env/build.env
#   # then fill in NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY and AVENLYO_RELEASE
#
# Every command in the deploy -- build, profile assertion, preflight, `up -d` -- reads that one
# file. See docs/production-runbook.md, "Deployment order".
#
# ---------------------------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------------------------
# The one value that tells staging and production apart. NODE_ENV cannot: staging runs
# NODE_ENV=production too, deliberately, so it exercises production runtime behaviour.
#
# It appears twice on a host, on purpose: here, as the profile's declaration, and in
# /etc/avenlyo/api.env, as the API process's own runtime identity. deploy/compose.yaml passes this
# copy in as AVENLYO_PROFILE_DEPLOYMENT_ENV so preflight can prove the two agree -- a container
# declaring one deployment while rendered from the other's profile is a cross-wire neither file can
# detect alone.
AVENLYO_DEPLOYMENT_ENV=staging

# The exact commit being deployed: a full 40-character lowercase SHA, nothing else. Not `latest`,
# not a branch, not an abbreviation.
AVENLYO_RELEASE=

# ---------------------------------------------------------------------------------------------
# Public hostnames -- deploy/Caddyfile substitutes these
# ---------------------------------------------------------------------------------------------
# Caddy's upstreams (web:3000, api:4000, internal :8080) are literals in the Caddyfile and are NOT
# configurable. These choose the public names only.
AVENLYO_WEB_HOST=staging.avenlyo.com
AVENLYO_API_HOST=api-staging.avenlyo.com

# ---------------------------------------------------------------------------------------------
# Build-time, browser-facing
# ---------------------------------------------------------------------------------------------
# Compiled into the client bundle at build time; setting them at runtime has no effect. They must
# agree with the hostnames above, and preflight fails the deployment if they do not.
NEXT_PUBLIC_APP_URL=https://staging.avenlyo.com
NEXT_PUBLIC_AVENLYO_API_URL=https://api-staging.avenlyo.com

# ---------------------------------------------------------------------------------------------
# The internal boundary
# ---------------------------------------------------------------------------------------------
# The web container's server-side path to the API, and the ONLY authority for it. Phase 19 put web
# and api on separate networks, so `http://api:4000` cannot resolve and must not come back: this
# value crossing Caddy is what keeps the API's trusted-proxy boundary a single hop.
#
# deploy/compose.yaml wires the web service's runtime AVENLYO_API_URL from this key, so the value
# preflight validates and the value the container runs with are the same value. It is identical in
# staging and production, and deploy/env/web.env.example no longer carries a second copy.
AVENLYO_API_URL=http://caddy:8080

# ---------------------------------------------------------------------------------------------
# Supabase project identity
# ---------------------------------------------------------------------------------------------
# THIS FILE IS THE SOLE AUTHORITY FOR THE **EXPECTED** PROJECT REF.
#
#   EXPECTED identity -> here, in the source-controlled deployment profile
#   ACTUAL   identity -> SUPABASE_URL in /etc/avenlyo/api.env
#   ops:preflight compares the two
#
# Two files, deliberately. An expectation stored beside the value it checks cannot detect a
# cross-wire -- a host pointed at the wrong database would carry the wrong URL and a matching wrong
# expectation in the same file and agree with itself. deploy/compose.yaml mirrors this value into
# the API container as AVENLYO_PROFILE_EXPECTED_SUPABASE_PROJECT_REF, under a distinct name, so the
# provenance of each half stays visible. Do NOT set it in api.env; the API no longer reads it there.
#
# Non-secret: a project ref, not a key. Optional on staging -- it is the environment where the
# project may legitimately be rebuilt, so an undeclared expectation is reported as `unverified` and
# does not fail. It is MANDATORY in production. Declaring it here anyway is recommended, and is what
# makes a staging host accidentally pointed at the production database provable.
#
# Only a canonical hosted project URL (https://<project-ref>.supabase.co) can be checked against it.
AVENLYO_EXPECTED_SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------------------------
# Server-only, environment-sensitive (COPY these two into /etc/avenlyo/api.env)
# ---------------------------------------------------------------------------------------------
# Non-secret, and environment-differing, so they belong in this file -- but the API reads them from
# /etc/avenlyo/api.env, not from the profile. Copy them across. Both must name the same origin as
# NEXT_PUBLIC_APP_URL above; they are the two controls standing between a customer's website and
# this API, so a drift here is a security defect, not a typo, and preflight fails the deployment
# for it.
API_CORS_ORIGIN=https://staging.avenlyo.com
WEB_CHAT_IFRAME_ORIGIN=https://staging.avenlyo.com

# ---------------------------------------------------------------------------------------------
# Environment-sensitive provider callbacks -- set ONLY in the server-only files, with the secrets
# ---------------------------------------------------------------------------------------------
# Listed here as a reminder that they are environment-sensitive and are checked, not as a place to
# put them. Each lives beside its credential in api.env.
#
#   GOOGLE_OAUTH_REDIRECT_URI          when set: the public API origin plus the callback route the
#                                      API actually serves,
#                                      /v1/scheduling/google-calendar/callback -- no query, no
#                                      fragment, no other host, no unpublished port
#   TWILIO_MESSAGING_WEBHOOK_BASE_URL  when set: the public API origin with NO path prefix; the
#                                      webhook routes are absolute, so a prefix builds a URL this
#                                      API does not serve
#   STRIPE_MODE                        `test` is permitted on staging; production requires `live`,
#                                      keyed on AVENLYO_DEPLOYMENT_ENV rather than NODE_ENV
#
# NEVER put a secret in this file or in a Docker build arg. Next inlines build args into the browser
# bundle, which would publish the value to every visitor. That means never here, and never
# NEXT_PUBLIC_-prefixed:
#   OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#   TWILIO_AUTH_TOKEN, GOOGLE_CLIENT_SECRET, AVENLYO_INTERNAL_BILLING_SECRET, OPENAI_WEBHOOK_SECRET
